#include <windows.h>
#include "evai_server_version.h"

101 ICON "favicon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EVAI_VERSION_MAJOR,EVAI_VERSION_MINOR,EVAI_VERSION_PATCH,0
 PRODUCTVERSION EVAI_VERSION_MAJOR,EVAI_VERSION_MINOR,EVAI_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "CompanyName", "everlib\0"
            VALUE "Author", "garnetrapture\0"
            VALUE "FileDescription", "EVAI Local Server\0"
            VALUE "FileVersion", EVAI_VERSION_TEXT
            VALUE "InternalName", "evai-server\0"
            VALUE "OriginalFilename", "evai-server.exe\0"
            VALUE "ProductName", "EVAI\0"
            VALUE "ProductVersion", EVAI_VERSION_TEXT
            VALUE "LegalCopyright", "everlib\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
