{
  "manifest_version": 3,
  "name": "EverSoul Native Context Bridge",
  "version": "1.0.0",
  "description": "Connects EverTalk to the optional local SQLite context host.",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://ai.everlib.pro/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
