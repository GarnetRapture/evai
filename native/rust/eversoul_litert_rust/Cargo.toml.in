[package]
name = "eversoul_litert_rust"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
name = "eversoul_litert_rust"
path = "@EVERSOUL_RUST_LIB_SOURCE@"
crate-type = ["cdylib"]

[dependencies]
antlr4rust = "0.5"
chrono = "0.4"
cxx = "=1.0.149"
indexmap = "2.12"
llguidance = { version = "=1.3.0", default-features = false, features = ["lark", "rayon", "ahash"] }
minijinja = { version = "=2.14.0", features = ["json", "preserve_order"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = { version = "1.0", features = ["preserve_order"] }
tokenizers = { version = "=0.21.0", default-features = false, features = ["onig"] }
fc_parser = { path = "@EVERSOUL_RUST_LITERT_LM_DIR@/cmake/rust/fc_parser" }
json_parser = { path = "@EVERSOUL_RUST_LITERT_LM_DIR@/cmake/rust/json_parser" }
python_parser = { path = "@EVERSOUL_RUST_LITERT_LM_DIR@/cmake/rust/python_parser" }

[patch.crates-io]
llguidance = { path = "@EVERSOUL_RUST_LLGUIDANCE_DIR@" }
toktrie = { path = "@EVERSOUL_RUST_TOKTRIE_DIR@" }
